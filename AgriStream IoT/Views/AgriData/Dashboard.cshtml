@model AgriStream_IoT.Models.SensorReading
@{
    ViewData["Title"] = "AgriStream Management Workspace";
}

<div class="container mt-5">
    <!-- Clean System Header Area -->
    <div class="row text-center mb-4">
        <div class="col-md-12">
            <h1 class="display-5 text-success">AgriStream Ingestion Command Center</h1>
            <p class="text-muted">Real-time gateway node for soil metric data packages and drone spatial imagery tracking profiles.</p>
        </div>
    </div>

    <!-- Alert Processing Banner -->
    @if (TempData["CommandStatus"] != null)
    {
        <div class="row">
            <div class="col-md-12">
                <div class="alert alert-warning text-center shadow-sm">
                    <strong>System Action Event:</strong> @TempData["CommandStatus"]
                </div>
            </div>
        </div>
    }

    <!-- 3-Column Balanced Service Panel Setup -->
    <div class="row">

        <!-- Column 1: Drone Imagery Node -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-success" style="border: 1px solid #28a745; border-radius: 4px; margin-bottom: 20px;">
                <div class="card-header bg-success text-white" style="background-color: #28a745; color: white; padding: 10px 15px;">
                    <h5 class="card-title mb-0">Aerial Imagery Data Ingestion</h5>
                </div>
                <div class="card-body" style="padding: 20px;">
                    <p class="text-muted small">Processes heavy multi-spectral aerial maps. Pushes assets into decentralized cloud targets to protect tracking lanes.</p>
                    <hr />
                    <form asp-controller="AgriData" asp-action="UploadDroneImage" method="post" enctype="multipart/form-data">
                        <div class="form-group mb-4">
                            <label class="form-label font-weight-bold">Select Drone Field Map File</label>
                            <input type="file" class="form-control" name="droneFile" accept="image/*" required />
                        </div>
                        <button type="submit" class="btn btn-success w-100" style="background-color: #28a745; color: white; width: 100%; border: none; padding: 8px;">Upload Inbound Field Asset</button>
                    </form>

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success mt-4 small" style="margin-top: 15px; padding: 10px; background-color: #d4edda; color: #155724; border-radius: 4px;">
                            <strong>Confirmed:</strong> @ViewBag.Message
                        </div>
                    }
                    @if (ViewBag.ImageUrl != null)
                    {
                        <div class="mt-3 text-center" style="margin-top: 15px; word-break: break-all;">
                            <label class="d-block font-weight-bold mb-2">Cloud Storage Asset Locator URI:</label>
                            <code class="small text-muted">@ViewBag.ImageUrl</code>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Column 2: Sensor Telemetry Node -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-primary" style="border: 1px solid #007bff; border-radius: 4px; margin-bottom: 20px;">
                <div class="card-header bg-primary text-white" style="background-color: #007bff; color: white; padding: 10px 15px;">
                    <h5 class="card-title mb-0">High-Velocity Telemetry Lane</h5>
                </div>
                <div class="card-body" style="padding: 20px;">
                    <form asp-controller="AgriData" asp-action="LogTelemetry" method="post">
                        <div class="form-group mb-3" style="margin-bottom: 15px;">
                            <label class="form-label">Hardware Identifier</label>
                            <input type="text" class="form-control" name="SensorId" placeholder="e.g., SENSOR-ZA-NODE-01" required />
                        </div>
                        <div class="row" style="margin-bottom: 15px;">
                            <div class="col-md-6 col-6">
                                <label class="form-label">Moisture (%)</label>
                                <input type="number" step="0.01" class="form-control" name="SoilMoisturePercentage" required />
                            </div>
                            <div class="col-md-6 col-6">
                                <label class="form-label">Temp (°C)</label>
                                <input type="number" step="0.01" class="form-control" name="TemperatureCelsius" required />
                            </div>
                        </div>
                        <div class="form-group mb-4" style="margin-bottom: 20px;">
                            <label class="form-label">Operational Network Flag</label>
                            <select class="form-select form-control" name="Status" required>
                                <option value="Normal">Nominal Functional Range</option>
                                <option value="Irrigation Needed">Environmental Variance Flagged</option>
                                <option value="Critical">Anomalous Critical Alert State</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100" style="background-color: #007bff; color: white; width: 100%; border: none; padding: 8px;">Commit Data Packet Stream</button>
                    </form>

                    @if (ViewBag.TelemetryMessage != null)
                    {
                        <div class="alert alert-primary mt-4 small" style="margin-top: 15px; padding: 10px; background-color: #cce5ff; color: #004085; border-radius: 4px;">
                            <strong>Confirmed:</strong> @ViewBag.TelemetryMessage
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Column 3: Infrastructure Integration Queue Node -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-warning" style="border: 1px solid #ffc107; border-radius: 4px; margin-bottom: 20px;">
                <div class="card-header bg-warning text-dark" style="background-color: #ffc107; color: #212529; padding: 10px 15px;">
                    <h5 class="card-title mb-0">Remote Device Actuation Engine</h5>
                </div>
                <div class="card-body" style="padding: 20px;">
                    <p class="text-muted small">Dispatches real-time override instructions. Buffering commands through message queues ensures 0 packet drops during midday transmission spikes.</p>
                    <hr />
                    <form asp-controller="AgriData" asp-action="TriggerIrrigation" method="post">
                        <input type="hidden" name="sensorId" value="SENSOR-01" />
                        <div class="form-group mb-4" style="margin-bottom: 20px;">
                            <label class="form-label font-weight-bold">Override Management Description</label>
                            <input type="text" class="form-control" name="statusReason" placeholder="e.g., Microclimate dryness compensation tracking" required />
                        </div>
                        <button type="submit" class="btn btn-warning w-100 font-weight-bold" style="background-color: #ffc107; color: #212529; width: 100%; border: none; padding: 8px; font-weight: bold;">Dispatch Controller Payload</button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>
