@model UserAccount
<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow">
        <div class="card-header bg-success text-white text-center"><h4>Create Account</h4></div>
        <div class="card-body">
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input asp-for="Username" class="form-control" required />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" minlength="8" required />
                    <div class="form-text">Use at least 8 characters with uppercase, lowercase, a number, and a special character.</div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Assigned System Role</label>
                    <select asp-for="RoleId" class="form-select" asp-items="ViewBag.Roles" required></select>
                    <span asp-validation-for="RoleId" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-success w-100">Register Profile</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
